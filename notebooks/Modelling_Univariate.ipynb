    "ticker = \"NVDA\"\n",
    "\n",
    "data = yf.download(\n",
    "    ticker,\n",
    "    start=\"2010-01-01\",\n",
    "    end=\"2026-01-01\",\n",
    "    interval=\"1d\",\n",
    "    auto_adjust=True\n",
    ")\n",
    "\n",
    "# Cierre\n",
    "\n",
    "prices = data[[\"Close\"]].copy()\n",
    "\n",
    "prices.columns = [\"Price\"]\n",
    "\n",
    "print(data.head())\n",
    "print(\"************************************************\")\n",
    "print(prices.head())\n"
   ]
